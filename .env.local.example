NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Server-only aggregate access for /stats. Never expose this key to the client.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=145688
POSTHOG_API_HOST=https://eu.posthog.com

# Server-only: never expose. Used for admin reads (e.g. live user count).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public anon key, needed for "Log ind med BetterLectio" SSR sessions.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# BetterLectio Events origin used for the verified login handoff.
BETTERLECTIO_EVENTS_URL=https://events.betterlectio.dk
